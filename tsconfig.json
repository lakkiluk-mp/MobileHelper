{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@etalon/runner": ["./packages/runner/src/index.ts"],
      "@etalon/shared": ["./packages/shared/src/index.ts"],
      "@etalon/content": ["./packages/content/src/browser.ts"]
    },
    "allowImportingTsExtensions": true
  },
  "include": ["src", "server", "packages"]
}
